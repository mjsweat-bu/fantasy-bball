# Copy to .api.env and fill in. .api.env is git-ignored; never commit it.
#
# ESPN_LEAGUE_ID: the number after leagueId= in your league's URL
#   https://fantasy.espn.com/basketball/league?leagueId=123456
ESPN_LEAGUE_ID=

# Private leagues only. Log in at fantasy.espn.com, then in your browser's dev tools
# (Application -> Cookies -> https://fantasy.espn.com) copy these two cookie values.
# SWID includes the curly braces, e.g. {ABCD1234-...}
ESPN_S2=
ESPN_SWID=
