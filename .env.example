# Copy to .env and fill in. .env is git-ignored; never commit it.
# Used by docker-compose.yml (to create the database) and by src/fbb/config.py (to connect).
POSTGRES_USER=fbb
POSTGRES_PASSWORD=change-me
POSTGRES_DB=fbb
POSTGRES_PORT=5433

# Optional: a hosted database (Neon). When set, Python code connects here instead of
# the local Docker database. Use a read-only role for analysis-only machines.
# DATABASE_URL=postgresql://user:password@ep-xxx-pooler.us-east-2.aws.neon.tech/fantasy-bball?sslmode=require
